# Experiment E: retrieval modes (graph-only, S3-Vectors-only, fused).
# DRAFT. Unapproved and unexecuted. Valid only for scripts/run-experiment.sh --dry-run.
# Format: scripts/README.md, "Experiment manifest contract". No spaces in values.
# PLACEHOLDERS the human replaces before an approval record is written
# (the record binds the sha256 of the final file, so any edit needs a new record):
#   ACCOUNT_ID       123456789012 is the documented example, not a real account.
#   DATASET_SNAPSHOT a draft name; the dataset-engineer has not defined snapshot ids.
#   OUTPUT_ROOT      /abs/outside/repo/... is a placeholder path; pick a durable directory
#                    outside the repository.
# MAX_TASKS 1500 = 3 modes x 500 queries. No OpenSearch exists in the Terraform, so there
# is no fourth mode. Retrieval only, with the offline LLM stub: no Bedrock charge.
# Cost basis: HOURLY_BURN_USD 0.62 is the tier M session burn (scripts/README.md,
# "Pipeline sizes", UNVERIFIED rates). 0.62 x 60 min / 60 = 0.62.
MANIFEST_VERSION=1
EXPERIMENT_ID=E
DESCRIPTION=retrieval-modes-graph-only-vector-only-fused-tier-m-draft
ENVIRONMENT=course
REGION=us-east-2
ACCOUNT_ID=123456789012
DATASET_SNAPSHOT=scholarchain-slice-m-25000-works-DRAFT
SIZE_TIER=M
MAX_MINUTES=60
MAX_CONCURRENCY=2
MAX_TASKS=1500
SPEND_CEILING_USD=0.80
HOURLY_BURN_USD=0.62
STOP_CONDITIONS=wall-clock,first-failure,spend-estimate
METRIC_NAMES=CPUUtilization,MemoryUtilization,SuccessfulRequestLatency,ThrottledRequests,MainRequestQueuePendingRequests
METRIC_NAMESPACES=AWS/ECS,AWS/DynamoDB,AWS/Neptune
OUTPUT_ROOT=/abs/outside/repo/scholarchain-experiments
ENTRY_POINT=script:experiments/e-retrieval-modes/run.sh
