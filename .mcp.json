{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${SCHOLARCHAIN_GITHUB_READ_TOKEN}"
      }
    },
    "aws-inspection": {
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server==1.6.0"],
      "env": {
        "AWS_API_MCP_PROFILE_NAME": "${SCHOLARCHAIN_AWS_INSPECTION_PROFILE}",
        "READ_OPERATIONS_ONLY": "true",
        "AWS_API_MCP_ALLOW_UNRESTRICTED_LOCAL_FILE_ACCESS": "no-access",
        "AWS_API_MCP_TELEMETRY": "false",
        "EXPERIMENTAL_AGENT_SCRIPTS": "false"
      }
    },
    "terraform-registry": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "hashicorp/terraform-mcp-server:1.3.0", "stdio", "--toolsets", "registry"]
    },
    "aws-documentation": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server==1.2.4"],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
